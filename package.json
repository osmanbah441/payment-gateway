{
  "name": "@osmanbah441/payment-gateway",
  "version": "0.1.0",
  "description": "Provider-agnostic TypeScript payment gateway & webhook package",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osmanbah441/payment-gateway.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
